			"config": "fundo.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"jei": "*",
		"modmenu": "*",
		"farmersdelight": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/user/st0m4rv3r",
				"modmenu.twitter": "https://x.com/stomarver"
			}
		}
	}
}
